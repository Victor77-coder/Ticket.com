# Copie para .env e preencha. NUNCA commite o .env.

# --- Banco de dados ---
# A porta 5438 é a exposta no host; dentro do Compose o Postgres atende em 5432.
POSTGRES_DB=ingressos
POSTGRES_USER=ingressos
POSTGRES_PASSWORD=
POSTGRES_PORT=5438

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- TMDb ---
# Crie a chave em https://www.themoviedb.org/settings/api
# Usada apenas pelo back-end; nunca chega ao navegador.
TMDB_API_KEY=

# --- Front-end ---
# A interface web roda em http://localhost:5003
NEXT_PUBLIC_SITE_PORT=5003
# Endereço da API dentro da rede do Compose (fetch server-side).
# Também usado pelo Route Handler /api/busca, que faz o proxy da busca do
# cabeçalho: o navegador nunca fala com o Django direto. Nenhuma variável
# adicional é necessária para a busca.
API_BASE_URL=http://backend:8000
